# CrossPilot M7 环境变量示例（请勿提交包含真实密钥的 .env 文件）
M7_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./m7_dev.db
STORAGE_ROOT=./m7_storage

# 云端大模型提供商：dashscope（阿里云百炼默认）| mock（离线演示回退）
CLOUD_LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo

# 视频合成硬门禁：无可用 ffmpeg 或设为 false 时严格返回 503 M7-5031
FFMPEG_BIN=ffmpeg
VIDEO_ENGINE_ENABLED=true

# 职责分离（禁自批）：生产与正式演示必须为 true
M7_STRICT_SEPARATION_OF_DUTIES=true

# 鉴权与跨域（开发占位，生产请替换为强随机串）
JWT_SECRET_KEY=change-me-in-local-env-only
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
