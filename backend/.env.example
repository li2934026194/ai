# CrossPilot M0-M8 环境变量模板（对齐 V1.1 技术栈选型，请勿提交包含真实密钥的 .env）
M7_ENV=development

# 1. 主数据库：PostgreSQL + asyncpg（推荐先执行 docker compose up -d）
# 若本机暂未起 PostgreSQL，可临时改为 sqlite+aiosqlite:///./m7_dev.db 进行单机演示
DATABASE_URL=postgresql+asyncpg://crosspilot:crosspilot123@127.0.0.1:5432/crosspilot

# 2. 文件/对象存储：MinIO（auto=连得通自动用 MinIO，否则落盘 STORAGE_ROOT）
STORAGE_BACKEND=auto
STORAGE_ROOT=./m7_storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crosspilot-assets
MINIO_SECURE=false

# 3. 缓存与异步队列：Redis + Celery（按需启用，连不通时自动降级为进程内缓存与 asyncio 后台任务）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 4. 向量检索：Milvus（通过 docker compose --profile vector up -d 按需启用）
VECTOR_BACKEND=auto
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=crosspilot_m1_products

# 5. 云端大模型提供商：dashscope（阿里云百炼默认）| mock（离线演示回退）
CLOUD_LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo

# 6. 视频合成硬门禁：无可用 ffmpeg 或设为 false 时严格返回 503 M7-5031
FFMPEG_BIN=ffmpeg
VIDEO_ENGINE_ENABLED=true

# 7. 职责分离（禁自批）：生产与正式演示必须为 true
M7_STRICT_SEPARATION_OF_DUTIES=true

# 8. 鉴权与跨域（开发占位，生产请替换为强随机串）
JWT_SECRET_KEY=change-me-in-local-env-only
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
