"""Pydantic 响应模型（api/schemas.py，PACK 4）。

只描述「壳」要吐给前端的 JSON 形状；所有数值都由 service 从 core/库取来后填入。
这里出现的字段名 = 前端 P1/P3 页面直接消费的键，不承载任何计算。
"""

from __future__ import annotations

from typing import Optional

from pydantic import BaseModel


# ---------------------------------------------------------------------------
# 三个通用字段：每个响应都必须带（source_type / as_of / method）
# ---------------------------------------------------------------------------
class Meta(BaseModel):
    """数据来源 + 截止日 + 回测方法（PACK 16b 增路线/目标溯源，均默认 None）。"""

    source_type: str
    as_of: str
    method: str
    route_code: Optional[str] = None
    objective_mode: Optional[str] = None
    lead_time_basis: Optional[str] = None


class Warning(BaseModel):
    """结构化警告位（不是错误）。"""

    code: str
    message: str


# ---------------------------------------------------------------------------
# GET /api/health
# ---------------------------------------------------------------------------
class Health(BaseModel):
    status: str
    dataset_count: int
    sqlalchemy_version: str


# ---------------------------------------------------------------------------
# GET /api/datasets
# ---------------------------------------------------------------------------
class DatasetItem(BaseModel):
    id: str
    name: str
    source_type: str
    created_at: str


class DatasetsResponse(BaseModel):
    datasets: list[DatasetItem]


# ---------------------------------------------------------------------------
# GET /api/p1/dashboard
# ---------------------------------------------------------------------------
class DashboardKpi(BaseModel):
    pending_sku_count: int       # 待补货 SKU 数（qty > 0）
    stockout_risk_count: int     # 断货风险 SKU 数
    total_capital: float         # 建议占用资金合计（缺成本 SKU 不计入）
    agent_runs_today: int        # 七 Agent 今日运行次数


class DashboardResponse(BaseModel):
    meta: Meta
    kpi: DashboardKpi


# ---------------------------------------------------------------------------
# GET /api/p2/skus
# ---------------------------------------------------------------------------
class SkuRow(BaseModel):
    sku: str
    title: str
    daily_avg: float             # 日均销量
    on_hand: float               # 在手
    in_transit: float            # 在途
    days_left: float             # 按当前需求可支撑天数
    stock_risk: str              # STOCKOUT / RISK / WATCH / LOW
    qty: int                     # 建议补货量（两步取整后）
    capital: Optional[float]     # 占用资金（qty × 单件成本；缺成本为 null）


class SkusResponse(BaseModel):
    meta: Meta
    skus: list[SkuRow]


# ---------------------------------------------------------------------------
# GET /api/p3/sku/{sku}
# ---------------------------------------------------------------------------
class S1Point(BaseModel):
    date: str
    qty: Optional[float]         # 断货日 None
    on_hand: float


class ModelMetrics(BaseModel):
    wape: Optional[float]
    bias: Optional[float]
    mae: Optional[float]
    n_obs: int


class Derivation(BaseModel):
    """推导链：σ_日 → σ_LT → SS → ROP → target → raw → qty。"""

    mu_daily: float
    sigma_daily: float
    sigma_lt: float
    z: float
    lead_time: int
    review_period: int
    ss: float
    rop: float
    target: float
    raw: float
    qty: int
    on_hand: float
    in_transit: float
    days_left: Optional[float]


class StockoutForward(BaseModel):
    """从今天起的 90 天前向断货预测（core.simulate.simulate_stockout）。"""

    horizon_days: int
    first_zero_date: Optional[str]
    zero_days: int
    coverage_days: int
    inbound_batch_count: int
    on_hand: float


class ComplianceCopy(BaseModel):
    """合规声明独立字段（PACK 15 / W4）。

    字面量只存在于 api.constants；这里只声明响应壳的字段形状，不复制任何文案。
    """

    no_replenish: str
    synthetic_notice: str


class Stockout(BaseModel):
    """PACK 14 / Z1：历史断货口径 + 前向预测。

    zero_days / first_date 来自已校准序列（qty=None 的历史断货日），
    lost_amount 只算少赚的毛利；缺成本/价格时为 null，并在 lost_amount_reason 里说明。
    """

    zero_days: int
    first_date: Optional[str]
    lost_amount: Optional[float]
    lost_amount_reason: Optional[str]
    gross_margin_rate: Optional[float] = None
    forward: Optional[StockoutForward] = None


class SkuDetailResponse(BaseModel):
    meta: Meta
    sku: str
    best_model: Optional[str]
    series: list[S1Point]
    per_model: dict[str, ModelMetrics]
    derivation: Derivation
    service_level: float
    service_level_source: str
    capital: Optional[float]
    stock_risk: str
    stockout: Optional[Stockout] = None   # PACK 14 新增（可选，老响应仍可解析）
    warning: Optional[Warning] = None
    compliance: Optional[ComplianceCopy] = None   # PACK 15 / W4 新增（只加字段，既有字段未动）
    evidence: Optional[dict] = None               # PACK 18 新增：数字出处证据块


# ---------------------------------------------------------------------------
# GET /api/p3/route-plan（PACK 11：多路线方案对比 + 三目标决策）
# 只新增模型；上面的既有响应字段一行未动。
# ---------------------------------------------------------------------------
class RoutePlanBase(BaseModel):
    """方案对比的基础输入，全部来自既有 /api/p3/sku 推导链。"""

    mu_daily: float
    on_hand: float
    in_transit: float
    cover_days: float          # (在手 + 在途) / 日均销量
    base_qty: int
    base_capital: Optional[float]
    service_level: float
    lead_time: int
    review_period: int
    sigma_daily: float
    moq: int
    pack_size: int
    unit_cost: Optional[float]


class RouteItem(BaseModel):
    """一条运输路线；参数来自「合成假设参数」表，结果由 core.routes 实时计算。"""

    code: str
    name: str
    transit_days: int           # 含起运与清关
    unit_freight: float         # ¥/件，合成假设
    min_qty: int                # 最小起运量，合成假设
    reliability: float          # 按时到货可靠性，合成假设
    order_qty: int
    total_freight: float
    cover_days: float
    gap_days: float             # 到货前裸露天数
    arrival_remaining_days: float
    risk_index: float
    risk_level: str
    recommendation: str


class ObjectiveItem(BaseModel):
    """一个决策目标；建议量与资金占用由各自的服务水平/覆盖周期参数算出。"""

    code: str
    name: str
    service_level: float
    review_factor: float
    review_period: float
    z: float
    ss: float
    rop: float
    target: float
    raw: float
    qty: int
    capital: Optional[float]
    difference_from: str


class RoutePlanResponse(BaseModel):
    meta: Meta
    sku: str
    base: RoutePlanBase
    assumption_note: str
    routes: list[RouteItem]
    objectives: list[ObjectiveItem]


# ---------------------------------------------------------------------------
# PACK 12：补货申请 → 审批 → 采购单 → 收货质检（只新增 DTO，上面既有模型零改动）
# 【合成演示业务，非真实生产业务】所有数量/金额都由 core 计算或由调用方传入，
# DTO 不承载任何写死的业务数字。
# ---------------------------------------------------------------------------
class ApplyCreateRequest(BaseModel):
    """提交补货申请。qty_propose 不传时由服务端按 core 建议量实时计算。"""

    dataset_id: str
    sku: str
    qty_propose: Optional[int] = None
    route_code: str = "sea"
    objective_mode: str = "profit"
    submit_user: str = "demo_submitter"
    submit: bool = True          # False 则只建草稿（draft），不进入待审批


class ApplyApproveRequest(BaseModel):
    apply_id: str
    approve_user: str = "demo_approver"


class ApplyRejectRequest(BaseModel):
    apply_id: str
    approve_user: str = "demo_approver"
    reject_reason: str = ""


class PoReceiveRequest(BaseModel):
    """收货质检：实收数量 + 不良品数量（不良品是实收的子集）。"""

    po_id: str
    receive_qty: int
    defect_qty: int = 0
    operator: str = "demo_receiver"


class PoShipRequest(BaseModel):
    po_id: str
    operator: str = "demo_shipper"


class PoCancelRequest(BaseModel):
    """取消采购单：必须写原因（破坏性动作，后端强校验非空）。"""

    po_id: str
    reason: str
    operator: str = "demo_operator"


class PurchaseOrderItem(BaseModel):
    po_id: str
    apply_id: str
    sku_id: str
    order_qty: int
    receive_qty: int
    defect_qty: int
    status: str
    status_label: str
    expect_arrive: Optional[str]
    actual_arrive: Optional[str]
    created_at: str
    cancel_user: Optional[str] = None
    cancel_reason: Optional[str] = None
    cancel_at: Optional[str] = None


class ReplenishApplyItem(BaseModel):
    apply_id: str
    sku_id: str
    dataset_id: str
    qty_propose: int
    capital: Optional[float]
    route_code: str
    objective_mode: str
    status: str
    status_label: str
    submit_user: str
    submit_at: str
    approve_user: Optional[str]
    approve_at: Optional[str]
    reject_reason: Optional[str]
    purchase_order: Optional[PurchaseOrderItem] = None


class ApplyFlowResponse(BaseModel):
    """单次流转操作的回执：申请人/审批人/收货人 + 时间 + 操作后的真实状态。"""

    operator: str
    operated_at: str
    action: str                  # submit / approve / reject / ship / receive
    message: str
    apply: ReplenishApplyItem
    purchase_order: Optional[PurchaseOrderItem] = None


class ApplyListResponse(BaseModel):
    total: int
    applies: list[ReplenishApplyItem]


# ---------------------------------------------------------------------------
# 结构化错误（绝不 500）
# ---------------------------------------------------------------------------
class ErrorResponse(BaseModel):
    code: str
    message: str
    available: Optional[int] = None

class DatasetImportRequest(BaseModel):
    """CSV 导入：name 是数据集名，csv_text 是完整 CSV 文本。"""

    name: str
    csv_text: str
    note: Optional[str] = None
    base_dataset_id: Optional[str] = None


class DatasetImportResponse(BaseModel):
    dataset_id: str
    name: str
    source_type: str
    skus: list[str]
    sku_count: int
    rows: int
    start_date: str
    end_date: str
    note: str
