"""公开数据构建器（PACK 22）：UCI Online Retail II 真实成交 + 透明库存仿真。

口径唯一来源：docs/pack22-context-pack.md §4（与 docs/pack22-data-source-plan.md
冲突时以 context pack 为准）。旧任务书的 90/60/80 已作废，本模块用 120/80/100。

分层（绝不混淆）：
- 销量：UCI 真实成交，按 (StockCode, date) 聚合 Quantity；不因仿真库存不足而改。
- 商品参数：price = median(UnitPrice) * 9.2；unit_cost = price * 0.45；其余交期为假设。
- 库存/在途：用真实日销量 + 假设交期跑一个透明的确定性仿真（on_hand 不得为负）。

所有参数集中在具名常量，便于数据卡逐条复现；dry-run 不写库。
"""

from __future__ import annotations

import math
from datetime import date, datetime, timedelta
from pathlib import Path
from typing import Any

import pandas as pd

# ---- 数据性质与来源 --------------------------------------------------------
OPEN_PUBLIC = "OPEN_PUBLIC"
UCI_DOWNLOAD_URL = "https://archive.ics.uci.edu/dataset/502/online+retail+ii"
UCI_FILENAME = "online_retail_II.xlsx"

# ---- 商品参数假设（context pack §4）---------------------------------------
FX_GBP_CNY = 9.2          # 1 GBP = 9.2 CNY（固定假设，仅换算展示金额）
COST_RATE = 0.45          # unit_cost = price * 0.45
MOQ = 100
PACK_SIZE = 50
LEAD_PROD = 30
LEAD_TRANSIT = 25
LEAD_CUSTOMS = 7
LEAD_INBOUND = 3
LEAD_TOTAL = LEAD_PROD + LEAD_TRANSIT + LEAD_CUSTOMS + LEAD_INBOUND  # 65

# ---- 选样与时间窗 ----------------------------------------------------------
DEFAULT_LIMIT = 20
DEFAULT_WINDOW_DAYS = 180
MIN_ACTIVE_DAYS = 120     # 窗口内至少 120 天有成交
DEFAULT_NAME = "公开-UCI礼品20SKU-180天"

# ---- 库存仿真参数（context pack §4：120/80/100 + 过去 28 天滚动均值）-------
ROLLING_DAYS = 28
INIT_ON_HAND_DAYS = 120   # 初始在库 = 120 天日均需求
REORDER_POINT_DAYS = 80   # 再订货点 = 80 天日均需求
TARGET_DAYS = 100         # 目标水位 = 100 天日均需求

_REQUIRED_COLUMNS = {
    "InvoiceNo", "StockCode", "Description", "Quantity", "InvoiceDate", "UnitPrice",
}


class PublicUciError(ValueError):
    """公开数据构建失败：文件缺失、列缺失或选样不足，均不伪造数据。"""


def load_transactions(xlsx_path: str | Path, *, sheet_names: list[str] | None = None) -> pd.DataFrame:
    """读 UCI xlsx 的两个 sheet 并合并；文件不存在明确报错，绝不伪造。"""
    path = Path(xlsx_path)
    if not path.exists():
        raise PublicUciError(
            f"UCI 文件不存在：{path}。请从 {UCI_DOWNLOAD_URL} 下载 "
            f"{UCI_FILENAME} 并放到 data/ 目录；本构建器不会用假数据代替。"
        )
    with pd.ExcelFile(path) as book:  # 用 with 确保句柄释放，否则 Windows 上临时文件删不掉
        sheets = sheet_names or list(book.sheet_names)
        parts: list[pd.DataFrame] = []
        for name in sheets:
            parts.append(pd.read_excel(book, sheet_name=name))
    if not parts:
        raise PublicUciError(f"xlsx 里没有可读 sheet：{path}")
    return pd.concat(parts, ignore_index=True)


def clean_transactions(df: pd.DataFrame) -> pd.DataFrame:
    """清洗：去取消单、非正数、空 StockCode，补 date 列；不做任何补零。"""
    missing = _REQUIRED_COLUMNS - set(df.columns)
    if missing:
        raise PublicUciError(f"UCI 数据缺列 {sorted(missing)}；需要 {sorted(_REQUIRED_COLUMNS)}")
    out = df.copy()
    invoice = out["InvoiceNo"].astype(str).str.strip()
    out = out[~invoice.str.startswith("C")]                       # 取消单
    code = out["StockCode"].astype(str).str.strip()
    out = out[code != ""]
    out["Quantity"] = pd.to_numeric(out["Quantity"], errors="coerce")
    out["UnitPrice"] = pd.to_numeric(out["UnitPrice"], errors="coerce")
    out = out[(out["Quantity"] > 0) & (out["UnitPrice"] > 0)]
    out["date"] = pd.to_datetime(out["InvoiceDate"]).dt.date
    keep = ["StockCode", "Description", "Quantity", "UnitPrice", "date"]
    return out[keep].reset_index(drop=True)


def select_skus(
    df: pd.DataFrame,
    *,
    limit: int = DEFAULT_LIMIT,
    window_days: int = DEFAULT_WINDOW_DAYS,
    min_active_days: int = MIN_ACTIVE_DAYS,
    end_date: date | None = None,
) -> tuple[list[str], date, date]:
    """窗口内总销量排序取前 limit；只保留至少 min_active_days 天有成交的 SKU。"""
    last = end_date or df["date"].max()
    if isinstance(last, datetime):
        last = last.date()
    start = last - timedelta(days=window_days - 1)
    window = df[(df["date"] >= start) & (df["date"] <= last)]
    ranked: list[tuple[str, float, int]] = []
    for code, group in window.groupby("StockCode"):
        active_days = int(group["date"].nunique())
        if active_days < min_active_days:
            continue
        total_qty = float(group["Quantity"].sum())
        ranked.append((str(code), total_qty, active_days))
    ranked.sort(key=lambda item: (-item[1], item[0]))  # 销量降序，同量按编码稳定
    skus = [item[0] for item in ranked[:limit]]
    if not skus:
        raise PublicUciError(
            f"窗口 {start}~{last} 内没有 SKU 满足至少 {min_active_days} 天成交；不伪造选样。"
        )
    return skus, start, last


def aggregate_daily(
    df: pd.DataFrame, skus: list[str], *, start: date, end: date
) -> dict[str, list[dict[str, Any]]]:
    """按 (SKU, 自然日) 聚合真实销量并补零；返回 {sku: [{date, sales_qty}, ...]}。"""
    day_count = (end - start).days + 1
    days = [start + timedelta(days=i) for i in range(day_count)]
    by_sku: dict[str, list[dict[str, Any]]] = {}
    for sku in skus:
        group = df[
            (df["StockCode"] == sku) & (df["date"] >= start) & (df["date"] <= end)
        ]
        qty_by_day: dict[date, float] = {}
        for _, row in group.iterrows():
            day = row["date"]
            qty_by_day[day] = qty_by_day.get(day, 0.0) + float(row["Quantity"])
        rows: list[dict[str, Any]] = []
        for day in days:
            rows.append({"date": day, "sales_qty": float(qty_by_day.get(day, 0.0))})
        by_sku[sku] = rows
    return by_sku


def build_product_master(df: pd.DataFrame, skus: list[str]) -> dict[str, dict[str, Any]]:
    """商品参数：price=median(UnitPrice)*9.2，cost=price*0.45，title=众数 Description。"""
    master: dict[str, dict[str, Any]] = {}
    for sku in skus:
        group = df[df["StockCode"] == sku]
        median_gbp = float(group["UnitPrice"].median())
        price = round(median_gbp * FX_GBP_CNY, 2)
        cost = round(price * COST_RATE, 2)
        titles = group["Description"].dropna().astype(str).str.strip()
        titles = titles[titles != ""]
        if len(titles) == 0:
            title = sku
        else:
            title = str(titles.value_counts().index[0])
        master[sku] = {
            "title": title,
            "unit_cost": cost,
            "price": price,
            "moq": MOQ,
            "pack_size": PACK_SIZE,
            "lead_prod": LEAD_PROD,
            "lead_transit": LEAD_TRANSIT,
            "lead_customs": LEAD_CUSTOMS,
            "lead_inbound": LEAD_INBOUND,
        }
    return master


def _rolling_mean_28(qtys: list[float]) -> list[float]:
    """过去 28 天滚动均值（含当天；不足 28 天用已有天数，不越界看未来）。"""
    means: list[float] = []
    for i in range(len(qtys)):
        begin = max(0, i - ROLLING_DAYS + 1)
        window = qtys[begin : i + 1]
        means.append(sum(window) / len(window))
    return means


def simulate_inventory(
    daily_by_sku: dict[str, list[dict[str, Any]]],
    *,
    init_days: int = INIT_ON_HAND_DAYS,
    reorder_days: int = REORDER_POINT_DAYS,
    target_days: int = TARGET_DAYS,
    lead_days: int = LEAD_TOTAL,
    moq: int = MOQ,
    pack_size: int = PACK_SIZE,
) -> dict[str, dict[str, Any]]:
    """确定性库存仿真：真实销量消耗仿真库存，on_hand 不得为负。

    - 初始在库 = init_days * 第 0 天滚动均值；
    - 每日先处理到仓，再扣真实需求（不足记「仿真断货」，on_hand=0，销量不改）；
    - 无在途且 on_hand <= 再订货点时下单，65 天后到仓；
    - 下单量 = max(moq, ceil((目标水位 - on_hand - in_transit)/pack_size)*pack_size)。

    返回 {sku: {"rows": [{date, on_hand, in_transit, sim_stockout}, ...],
                "stockout_days": int}}。
    """
    result: dict[str, dict[str, Any]] = {}
    for sku, rows in daily_by_sku.items():
        qtys = [float(row["sales_qty"]) for row in rows]
        means = _rolling_mean_28(qtys)
        on_hand = max(0.0, init_days * means[0])
        in_transit = 0.0
        arrivals: list[tuple[int, float]] = []  # (到货日索引, 数量)
        sim_rows: list[dict[str, Any]] = []
        stockout_days = 0
        for index, row in enumerate(rows):
            remaining: list[tuple[int, float]] = []
            for arrive_index, qty in arrivals:
                if arrive_index == index:
                    on_hand += qty
                    in_transit -= qty
                else:
                    remaining.append((arrive_index, qty))
            arrivals = remaining

            demand = qtys[index]
            sim_stockout = demand > on_hand
            if sim_stockout:
                stockout_days += 1
                on_hand = 0.0            # 仿真库存不足按 0 记；真实销量 qty 绝不改
            else:
                on_hand -= demand

            reorder_point = reorder_days * means[index]
            target = target_days * means[index]
            if on_hand <= reorder_point and in_transit <= 0:
                need = target - on_hand - in_transit
                order_qty = max(moq, math.ceil(need / pack_size) * pack_size)
                in_transit += order_qty
                arrivals.append((index + lead_days, float(order_qty)))

            on_hand = max(0.0, on_hand)
            in_transit = max(0.0, in_transit)
            sim_rows.append(
                {
                    "date": row["date"],
                    "on_hand": on_hand,
                    "in_transit": in_transit,
                    "sim_stockout": sim_stockout,
                }
            )
        result[sku] = {"rows": sim_rows, "stockout_days": stockout_days}
    return result


def build_note(sim: dict[str, dict[str, Any]], start: date, end: date) -> str:
    """数据集说明：来源/许可/窗口 + 真实与仿真分层 + 全部假设参数。"""
    total_stockout = sum(item["stockout_days"] for item in sim.values())
    base = (
        f"公开真实需求：UCI Online Retail II（CC BY 4.0），窗口 {start.isoformat()}~"
        f"{end.isoformat()}，{len(sim)} SKU；库存/在途为仿真；成本按售价 45% 假设、"
        f"按 1 GBP=9.2 CNY 换算；MOQ=100、箱规=50、生产 30 天、运输 25 天、清关 7 天、"
        f"入仓 3 天为假设参数。"
    )
    extra = (
        f" 日均需求取过去 {ROLLING_DAYS} 天滚动均值，初始在库 {INIT_ON_HAND_DAYS} 天、"
        f"再订货点 {REORDER_POINT_DAYS} 天、目标水位 {TARGET_DAYS} 天、交期 {LEAD_TOTAL} 天；"
        f"销量为 UCI 真实成交、未因仿真库存不足而改，仿真断货 {total_stockout} 个 SKU·日按 0 记。"
    )
    return base + extra


def build_frames(
    daily_by_sku: dict[str, list[dict[str, Any]]],
    master: dict[str, dict[str, Any]],
    sim: dict[str, dict[str, Any]],
    *,
    source_type: str = OPEN_PUBLIC,
) -> dict[str, list[dict[str, Any]]]:
    """产出 upsert_dataset 需要的四张表记录（dataset_id 留空待盖写）。"""
    products: list[dict[str, Any]] = []
    sales: list[dict[str, Any]] = []
    inventory: list[dict[str, Any]] = []
    for sku, rows in daily_by_sku.items():
        meta = master[sku]
        products.append(
            {
                "dataset_id": "",
                "sku": sku,
                "title": meta["title"],
                "unit_cost": meta["unit_cost"],
                "price": meta["price"],
                "moq": meta["moq"],
                "pack_size": meta["pack_size"],
                "lead_prod": meta["lead_prod"],
                "lead_transit": meta["lead_transit"],
                "lead_customs": meta["lead_customs"],
                "lead_inbound": meta["lead_inbound"],
                "source_type": source_type,
            }
        )
        sim_rows = sim[sku]["rows"]
        for row, sim_row in zip(rows, sim_rows):
            qty = float(row["sales_qty"])
            sales.append(
                {
                    "dataset_id": "",
                    "sku": sku,
                    "date": row["date"],
                    "qty": qty,
                    "revenue": round(qty * meta["price"], 2),
                    "is_refund": 0,
                    "source_type": source_type,
                }
            )
            inventory.append(
                {
                    "dataset_id": "",
                    "sku": sku,
                    "date": sim_row["date"],
                    "on_hand": sim_row["on_hand"],
                    "in_transit": sim_row["in_transit"],
                    "source_type": source_type,
                }
            )
    return {
        "products": products,
        "sales_daily": sales,
        "inventory_daily": inventory,
        "inbound_batches": [],  # 在途是仿真快照，不落真实批次表
    }


class PublicUciLoader:
    """满足 loaders.base.Loader 协议：一次构建公开数据集的四张事实表。"""

    source_type = OPEN_PUBLIC

    def __init__(
        self,
        xlsx_path: str | Path,
        *,
        name: str = DEFAULT_NAME,
        limit: int = DEFAULT_LIMIT,
        window_days: int = DEFAULT_WINDOW_DAYS,
        sheet_names: list[str] | None = None,
    ) -> None:
        raw = load_transactions(xlsx_path, sheet_names=sheet_names)
        clean = clean_transactions(raw)
        skus, start, end = select_skus(clean, limit=limit, window_days=window_days)
        self.name = name
        self.skus = skus
        self.start = start
        self.end = end
        self.daily = aggregate_daily(clean, skus, start=start, end=end)
        self.master = build_product_master(clean, skus)
        self.sim = simulate_inventory(self.daily)
        self.note = build_note(self.sim, start, end)
        self._frames = build_frames(self.daily, self.master, self.sim)
        self.sku_count = len(skus)
        self.row_count = len(self._frames["sales_daily"])

    def load(self) -> dict[str, list[dict[str, Any]]]:
        return self._frames


__all__ = [
    "OPEN_PUBLIC", "UCI_DOWNLOAD_URL", "UCI_FILENAME", "DEFAULT_NAME",
    "FX_GBP_CNY", "COST_RATE", "MOQ", "PACK_SIZE", "LEAD_TOTAL",
    "ROLLING_DAYS", "INIT_ON_HAND_DAYS", "REORDER_POINT_DAYS", "TARGET_DAYS",
    "PublicUciError", "load_transactions", "clean_transactions", "select_skus",
    "aggregate_daily", "build_product_master", "_rolling_mean_28",
    "simulate_inventory", "build_note", "build_frames", "PublicUciLoader",
]
