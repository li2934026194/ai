[Unit]
Description=Pilot FastAPI (cross-border replenishment assistant)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=pilot
Group=pilot
WorkingDirectory=/opt/pilot
EnvironmentFile=/opt/pilot/.env
ExecStart=/opt/pilot/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
