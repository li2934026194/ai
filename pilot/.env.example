# 复制为 .env（不要提交到 git），或直接在左侧栏填写
SHOP_DOMAIN=your-store.myshopify.com
SHOP_TOKEN=shpat_xxxxxxxxxxxxxxxx

# 如果店铺是真实经营店（有真实成交），设为 1；开发店/测试店保持 0
SHOP_IS_LIVE=0

# PACK 23：RBAC / JWT / 阿里云部署
# 演示模式=0（旧接口保持不鉴权）；生产必须=1
AUTH_ENABLED=0
# 生产必须改成 >=32 字节的随机值，绝不能沿用开发默认值
AUTH_JWT_SECRET=change-me-to-a-random-32-byte-secret
AUTH_JWT_ISSUER=pilot
AUTH_JWT_AUDIENCE=pilot-api
AUTH_JWT_TTL_MINUTES=60
# 生产前端域名，逗号分隔；只给老师看可填 ECS 公网 IP/域名
CORS_ORIGINS=*
# 初始化管理员（仅 scripts/seed_rbac.py 读取，不写进代码）
RBAC_ADMIN_USERNAME=admin
RBAC_ADMIN_PASSWORD=change-me-at-least-8-chars
