:root{
  --bg:#F7F8FA;
  --card:#FFFFFF;
  --border:#E5E7EB;
  --primary:#1B2A4A;
  --healthy:#12B886;
  --warn:#E8590C;
  --neutral:#6B7280;
  --red:#E03131;
  --text:#1F2937;
  --muted:#9CA3AF;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
  font-size:14px;
  line-height:1.6;
  overflow-x:auto;
  min-width:1660px;
}
.badge{display:inline-block;font-size:12px;font-weight:700;padding:5px 10px;border-radius:4px;letter-spacing:.3px;white-space:nowrap;}
.badge-online{background:#E6F7F1;color:#0E9F6E;border:1px solid #B7E4D2;}
.badge-offline{background:#FFF3E6;color:var(--warn);border:1px solid #F5D98A;}
.as-of{font-size:12px;color:var(--neutral);}

.sidebar{position:fixed;top:0;left:0;bottom:0;width:220px;z-index:100;background:var(--primary);color:#fff;display:flex;flex-direction:column;}
.brand{padding:24px 20px 20px;border-bottom:1px solid rgba(255,255,255,.12);}
.brand-name{font-size:20px;font-weight:700;line-height:1.4;}
.brand-sub{font-size:11px;color:rgba(255,255,255,.6);margin-top:4px;}
.tabs{display:flex;flex-direction:column;padding:12px 0;gap:2px;flex:1;}
.tab{appearance:none;background:transparent;border:0;border-left:3px solid transparent;text-align:left;padding:12px 20px;font-size:14px;color:rgba(255,255,255,.78);cursor:pointer;font-weight:500;display:flex;align-items:center;gap:10px;width:100%;}
.tab:hover{background:rgba(255,255,255,.06);color:#fff;}
.tab.active{background:rgba(255,255,255,.1);border-left-color:#fff;color:#fff;font-weight:700;}
.tab .ico{font-size:16px;width:18px;text-align:center;flex:none;}
.sidebar-foot{font-size:11px;color:rgba(255,255,255,.6);padding:16px 20px 20px;border-top:1px solid rgba(255,255,255,.12);}
.app{margin-left:220px;width:auto;padding:0 32px 56px;}
.page-title{font-size:26px;font-weight:700;color:var(--primary);margin:0 0 20px;line-height:1.35;}

.card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:22px;}
.card-title{font-size:17px;font-weight:700;color:var(--primary);margin:0 0 12px;}
.muted{color:var(--neutral);}
.small{font-size:11px;}
.num{font-variant-numeric:tabular-nums;}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.grid-2{display:grid;grid-template-columns:1.35fr 1fr;gap:20px;}
.stack{display:flex;flex-direction:column;gap:20px;}
.section-gap{margin-top:20px;}

.pill{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;border-radius:10px;white-space:nowrap;}
.pill-good{background:#E6F7F1;color:#0E9F6E;}
.pill-warn{background:#FFF3E6;color:var(--warn);}
.pill-bad{background:#FDECEC;color:var(--red);}
.pill-gray{background:#F3F4F6;color:var(--neutral);}

.alert{border-radius:6px;padding:10px 14px;font-size:13px;margin:14px 0;}
.alert-warn{background:#FFF8E6;border:1px solid #F5D98A;color:#8A5A00;}
.alert-missing{background:#FDECEC;border:1px solid #F5B7B7;color:#A12C2C;}

.tbl{width:100%;border-collapse:separate;border-spacing:0;font-size:13px;}
.tbl th{position:sticky;top:0;z-index:2;text-align:left;color:var(--neutral);font-weight:600;font-size:11px;letter-spacing:.5px;padding:12px 10px;border-bottom:1px solid var(--border);background:#FAFBFC;white-space:nowrap;}
.tbl td{padding:12px 10px;border-bottom:1px solid #F0F1F3;vertical-align:middle;}
.tbl tbody tr:hover{background:#FAFBFC;}
.tbl td:first-child{font-weight:600;}
.tbl tr:last-child td{border-bottom:0;}
.tbl-legend{font-size:12px;color:var(--neutral);margin-bottom:12px;display:flex;align-items:center;gap:6px;}
.tbl-legend .lg{display:inline-block;width:8px;height:8px;border-radius:2px;flex:none;}
.lg-red{background:var(--red);}
.lg-warn{background:var(--warn);}
.lg-green{background:var(--healthy);}
.empty-line{font-size:12px;color:var(--muted);text-align:center;padding:14px 8px 0;}

.barcell{display:flex;align-items:center;gap:8px;}
.bartrack{width:140px;height:8px;background:#EEF0F3;border-radius:4px;overflow:hidden;flex:none;}
.barfill{height:100%;border-radius:4px;}
.barnum{font-size:11px;white-space:nowrap;color:var(--text);}

.topbar{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;}
.topbar-left{display:flex;align-items:center;gap:10px;position:relative;}
.dataset-btn{background:#F3F5F8;border:1px solid var(--border);border-radius:6px;padding:6px 12px;cursor:pointer;font-size:13px;color:var(--primary);font-weight:600;}
.dataset-name{font-size:14px;font-weight:600;color:var(--text);}
.dataset-menu{position:absolute;top:40px;left:0;background:#fff;border:1px solid var(--border);border-radius:6px;box-shadow:0 4px 12px rgba(0,0,0,.08);padding:6px;min-width:200px;z-index:5;}
.dataset-menu div{padding:6px 10px;border-radius:4px;cursor:pointer;font-size:13px;}
.dataset-menu div:hover{background:#F3F5F8;}
.sim-tag{margin-left:8px;padding:1px 6px;border-radius:9px;background:#FFF3E0;color:#B26A00;font-size:11px;font-weight:600;white-space:nowrap;}
.kpi .label{font-size:11px;color:var(--neutral);}
.kpi .value{font-size:32px;font-weight:700;color:var(--primary);margin:6px 0 2px;letter-spacing:-.5px;}
.kpi .foot{font-size:11px;color:var(--muted);}
.chart{width:100%;height:210px;}
.chart-lg{width:100%;height:250px;}
.chart-fallback{height:100%;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--neutral);font-size:12px;border:1px dashed var(--border);border-radius:6px;padding:12px;}

.conclusion{background:#F3F7F4;border:1px solid #CFE9DD;border-radius:6px;padding:14px;}
.conclusion .big{font-size:22px;font-weight:700;color:var(--primary);}
.conclusion .row{display:flex;justify-content:space-between;padding:3px 0;font-size:13px;}
details{margin-top:6px;border-top:1px solid var(--border);padding-top:12px;}
summary{cursor:pointer;list-style:none;font-weight:700;color:var(--primary);font-size:13px;}
summary::-webkit-details-marker{display:none;}

.derive{display:flex;flex-direction:column;gap:8px;margin-top:12px;font-size:13px;}
.derive-step{border:1px solid var(--border);border-radius:6px;overflow:hidden;background:#fff;}
.derive-step>summary{cursor:pointer;list-style:none;padding:10px 14px;display:flex;align-items:center;gap:10px;font-weight:600;color:var(--text);background:#FAFBFC;}
.derive-step>summary::-webkit-details-marker{display:none;}
.derive-step>summary:hover{background:#F3F5F8;}
.derive-step .step-name{color:var(--neutral);font-weight:600;min-width:64px;}
.derive-step .step-val{color:var(--primary);font-weight:700;}
.derive-step .step-formula{color:var(--muted);font-size:12px;margin-left:auto;}
.derive-step .step-body{padding:10px 14px;border-top:1px solid #F0F1F3;font-size:12px;color:var(--neutral);line-height:1.7;}
.derive-step .step-body .eq-line{font-family:"SF Mono",Consolas,monospace;color:var(--primary);background:#F8F9FB;border-radius:4px;padding:6px 10px;display:inline-block;margin-top:6px;}
.derive-arrow{align-self:center;color:var(--muted);font-weight:700;}

.placeholder{background:#fff;border:1px dashed var(--border);border-radius:10px;padding:40px;text-align:center;color:var(--neutral);font-size:14px;}
.ws-log{border:1px solid var(--border);border-radius:6px;background:#0E1621;color:#D6E2F0;padding:12px;min-height:220px;max-height:360px;overflow-y:auto;font-family:ui-monospace,Consolas,monospace;font-size:12px;line-height:1.7;white-space:pre-wrap;word-break:break-all;}
.ws-line{white-space:pre-wrap;word-break:break-all;}
.filter-input{padding:6px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px;width:220px;}
.filter-select{padding:6px 10px;border:1px solid var(--border);border-radius:6px;font-size:13px;}
.btn-plain{padding:6px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px;background:#F3F5F8;cursor:pointer;font-weight:600;}
.btn-primary{padding:8px 16px;background:var(--primary);color:#fff;border:0;border-radius:6px;cursor:pointer;font-weight:600;}
.btn-primary:disabled{opacity:.6;cursor:not-allowed;}
.ws-input{padding:7px 10px;border:1px solid var(--border);border-radius:6px;font-family:inherit;font-size:13px;}

/* PACK 23：权限中枢 */
.rbac-label{display:block;margin:10px 0 4px;font-size:13px;font-weight:600;color:var(--neutral);}
.rbac-h2{margin:0 0 12px;font-size:16px;color:var(--primary);}
.rbac-form{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
.rbac-form .filter-input{width:180px;}
.rbac-form select{width:180px;min-height:56px;}
.rbac-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.rbac-table{width:100%;border-collapse:collapse;font-size:12px;}
.rbac-table th{text-align:left;color:var(--neutral);font-weight:600;border-bottom:1px solid var(--border);padding:7px 6px;}
.rbac-table td{border-bottom:1px solid #F0F1F3;padding:8px 6px;vertical-align:top;}
.rbac-table code{background:#F3F5F8;border-radius:4px;padding:1px 4px;font-size:11px;}
