# Large / runtime artifacts (must NOT be committed)
pilot/.pg/
pilot/.venv/
pilot/frontend/node_modules/
pilot/web/dist/
pilot/.idea/
pilot/.pytest_cache/
pilot/_backup_*/

# Data & database files
pilot/data/*.zip
pilot/data/*.xlsx
pilot/data/*.csv
pilot/data/*.db
pilot/data/*.sqlite*
*.db-journal
# keep the small reference sample (cloud agents need it)
!pilot/data/sample_*.csv

# Logs & caches
*.log
__pycache__/
*.pyc
.pytest_cache/

# M7 runtime & local env/build artifacts
.env
backend/.env
frontend/.env
backend/*.db*
backend/m7_storage/
frontend/node_modules/
frontend/dist/

# Editor / OS
.DS_Store
Thumbs.db

# Binary docs: source docx stays local, only the converted .md is committed
*.docx
*.doc
~$*.doc*